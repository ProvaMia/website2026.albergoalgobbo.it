{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../../packages/shared && pnpm run build && cd ../../apps/frontend && pnpm run build",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/chat.js": {
      "memory": 256,
      "maxDuration": 30
    }
  }
}
