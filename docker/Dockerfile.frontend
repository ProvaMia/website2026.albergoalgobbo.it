# syntax=docker/dockerfile:1.7
# Multi-stage Dockerfile for the Vite + React frontend.
# Build context: repo root (see docker-compose.yml).

ARG NODE_VERSION=22-alpine

# ──────────────────────────────────────────────────────────────────────────────
# Stage 1: build shared + frontend with full workspace
# ──────────────────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS builder
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /repo

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/shared packages/shared
COPY apps/frontend apps/frontend
# Backend manifest required for the workspace graph to resolve
COPY apps/backend/package.json apps/backend/

RUN pnpm install --frozen-lockfile

RUN pnpm --filter @brochure/shared build \
 && pnpm --filter @brochure/frontend build

# ──────────────────────────────────────────────────────────────────────────────
# Stage 2: nginx runtime serving the static SPA bundle
# ──────────────────────────────────────────────────────────────────────────────
FROM nginx:alpine AS runner

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /repo/apps/frontend/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
