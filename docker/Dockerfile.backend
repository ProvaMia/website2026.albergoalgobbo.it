# syntax=docker/dockerfile:1.7
# Multi-stage Dockerfile for the Hono backend.
# Build context: repo root (see docker-compose.yml).

ARG NODE_VERSION=22-alpine

# ──────────────────────────────────────────────────────────────────────────────
# Stage 1: build shared + backend with full workspace
# ──────────────────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS builder
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /repo

# Full workspace (minus what .dockerignore excludes)
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/shared packages/shared
COPY apps/backend apps/backend
# Frontend manifest is required for pnpm to resolve the workspace graph
COPY apps/frontend/package.json apps/frontend/

RUN pnpm install --frozen-lockfile

# Build shared first so the backend's type imports resolve to packages/shared/dist
RUN pnpm --filter @brochure/shared build \
 && pnpm --filter @brochure/backend build

# Produce a self-contained, production-only deployment bundle.
# pnpm v10 requires --legacy (or inject-workspace-packages) to deploy
# workspaces that use standard (non-injected) dependencies.
RUN pnpm --filter @brochure/backend --prod --legacy deploy /out

# ──────────────────────────────────────────────────────────────────────────────
# Stage 2: minimal runtime image
# ──────────────────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV API_PORT=3001

COPY --from=builder /out /app

EXPOSE 3001

CMD ["node", "dist/index.js"]
